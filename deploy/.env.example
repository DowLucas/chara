# Chara self-host settings.
#
# Easiest: run ./setup.sh — it asks a few questions and writes .env for you.
# Manual:  cp .env.example .env and fill in everything marked REQUIRED.
# Never commit the resulting .env file.

# ------------------------------------------------------------------
# REQUIRED — where is your server?
# ------------------------------------------------------------------
# The address people will type into the Chara app. Magic-link emails and
# invite links are built from this, so it must be reachable FROM A PHONE:
#   - Internet + HTTPS:   https://chara.example.com   (use the Caddy add-on)
#   - Home network only:  http://192.168.1.10:8080    (this machine's LAN IP)
# "localhost" will NOT work — a phone can't open that.
BASE_URL=

# Only for the Caddy add-on (docker-compose.caddy.yml): the bare domain.
CHARA_DOMAIN=

# ------------------------------------------------------------------
# REQUIRED — secrets (generate, don't invent)
# ------------------------------------------------------------------
# openssl rand -base64 48   (must be at least 32 characters)
JWT_SECRET=
# openssl rand -hex 24
POSTGRES_PASSWORD=
# MinIO (file storage) root login — any username + `openssl rand -hex 24`
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ------------------------------------------------------------------
# REQUIRED — email for sign-in links
# ------------------------------------------------------------------
# Chara signs people in with a magic link sent by email, so it needs a way
# to send email. Pick ONE:
#
#   A) any SMTP account (Gmail app password, Fastmail, Mailgun, your ISP…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address; defaults to SMTP_USER.
SMTP_FROM=
#   B) no email yet — TEST MODE. Anyone who enters an email address is
#      signed straight in (no link, no check). Fine for trying it out on
#      your home network; switch to SMTP before inviting friends.
DEV_MODE=false

# ------------------------------------------------------------------
# OPTIONAL
# ------------------------------------------------------------------
# Image tag to run. `latest` follows main; `sha-<short>` pins a specific
# build (see https://github.com/DowLucas/chara/pkgs/container/chara-backend).
CHARA_VERSION=latest

# Which compose files `docker compose` uses. Add the Caddy add-on here so
# every plain `docker compose …` command picks it up:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.caddy.yml
COMPOSE_FILE=docker-compose.yml

# Host port / bind address for the API (ignored when using the Caddy add-on).
API_PORT=8080
API_BIND=0.0.0.0

# Reverse-proxy CIDRs whose X-Forwarded-For to trust. Set this if you put
# your own nginx/Traefik/Caddy in front; the bundled Caddy add-on sets it.
TRUSTED_PROXIES=

# AI features. One key enables BOTH:
#   - Receipt scanning (line-item extraction from a photo or PDF)
#   - Voice expenses (speak an expense, get a draft back)
# Get a key at https://aistudio.google.com — leave empty to hide both.
#
# PRIVACY, read before enabling: with this set, your users' receipt
# images AND their voice recordings leave your server for Google's
# Gemini API in the US. Chara holds them in memory for the single
# request — never written to disk, object storage, or logs — but the
# call itself is outbound, and your users should be told. Leaving this
# empty keeps everything on your own hardware; the app then hides the
# scan and mic buttons rather than offering something that cannot work.
GEMINI_API_KEY=

# Only if you also host the web version of the app somewhere:
# comma-separated origins, e.g. https://app.example.com
ALLOWED_CORS_ORIGINS=

# Bearer token for POST /api/admin/notify (push a note to every device).
# openssl rand -hex 32 — unset = endpoint disabled.
ADMIN_API_TOKEN=

# Expo push access token — only needed for high push volume.
EXPO_ACCESS_TOKEN=

# Android App Links for a custom-built app (most people leave these empty).
ANDROID_PACKAGE_NAME=
ANDROID_CERT_FINGERPRINT=
