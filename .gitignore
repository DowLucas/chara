.superpowers/

# OS / editor
.DS_Store
*.swp
*.swo
.idea/
.vscode/
*~

# Go
*.test
*.out
coverage.out
coverage.html

# Local secret overrides — never commit
**/.env.local
**/.env.*.local
deploy/.env

# Release output, regenerated each release. build-artifacts/ holds the local
# Android .aab builds; app/store* is an `eas metadata:pull` of the App Store
# listing (screenshots included), re-pulled every time so a push never reverts
# console edits. Keeping these out also keeps them out of the EAS upload.
build-artifacts/
app/store.config.json
app/store/

# Gradle output for the local Expo modules. Regenerated by every build, and
# it was briefly committed by a careless `git add app/`.
app/modules/*/android/build/
