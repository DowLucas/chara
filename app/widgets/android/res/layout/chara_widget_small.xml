<?xml version="1.0" encoding="utf-8"?>
<!--
  Small family: a single per-currency hero.

  Shows one currency rather than a cross-currency sum. The app refuses to
  collapse mixed-sign currencies into one number, and the widget must not
  reintroduce that just to fit a small tile.

  Ids referenced by CharaWidgetProvider must stay in sync with the list
  layout, since one provider renders both.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/chara_widget_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:fontFamily="@font/snpro_semibold"
        android:textSize="14sp"
        android:maxLines="3"
        android:textColor="@color/chara_widget_graphite" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmono_regular"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="@color/chara_widget_lead" />

        <TextView
            android:id="@+id/hero_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/jetbrainsmono_medium"
            android:fontFeatureSettings="tnum"
            android:textSize="24sp"
            android:maxLines="1"
            android:textColor="@color/chara_widget_graphite" />

        <TextView
            android:id="@+id/hero_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrainsmono_regular"
            android:textSize="10sp"
            android:textColor="@color/chara_widget_lead" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/partial_marker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:visibility="gone"
                android:text="!"
                android:fontFamily="@font/jetbrainsmono_regular"
                android:textSize="9sp"
                android:textColor="@color/chara_widget_lead" />

            <TextView
                android:id="@+id/updated_at"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/jetbrainsmono_regular"
                android:textSize="9sp"
                android:textColor="@color/chara_widget_lead" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
