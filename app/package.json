{
  "name": "chara",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=dev expo start",
    "start:tailscale": "APP_VARIANT=dev REACT_NATIVE_PACKAGER_HOSTNAME=$(tailscale ip -4 | head -1) expo start",
    "android": "APP_VARIANT=dev expo start --android",
    "ios": "APP_VARIANT=dev expo start --ios",
    "web": "APP_VARIANT=dev expo start --web",
    "test": "jest",
    "build:android": "eas build -p android --profile production",
    "submit:android": "eas submit -p android --profile production",
    "i18n:extract": "i18next 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' -c i18next-parser.config.js",
    "i18n:check": "i18next 'app/**/*.{ts,tsx}' 'components/**/*.{ts,tsx}' 'lib/**/*.{ts,tsx}' -c i18next-parser.config.js --fail-on-update"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "isolatedModules": true
        }
      ]
    }
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "dependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@expo/dom-webview": "~58.0.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "date-fns": "^4.3.0",
    "date-fns-tz": "^3.2.0",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.20",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-share-intent": "^9.0.0",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-system-ui": "~58.0.7",
    "i18next": "^26.1.0",
    "phosphor-react-native": "^3.0.6",
    "posthog-react-native": "^4.45.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.7",
    "react-native": "0.88.1",
    "react-native-blob-util": "^0.24.10",
    "react-native-pdf": "^7.0.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-wheel-color-picker": "^1.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "i18next-parser": "^9.3.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.1.5",
    "typescript": "~6.0.3"
  }
}
